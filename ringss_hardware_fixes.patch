+    except Exception as e:
+        logging.error("Could not stop the service cluster cleanly: %s", e)
+    finally:
+        sock.close()
+
+    if wd_thread is not None and wd_thread.is_alive():
+        wd_thread.join(timeout=52.0)
+        if wd_thread.is_alive():
+            logging.error("Watchdog thread did not stop within the shutdown timeout.")
+
