new file mode 100644
index 0000000..a16b1d6
--- /dev/null
+++ b/services/abort_control.py
@@ -0,0 +1,61 @@
+import logging
+import threading
+
+import zmq
+
+
+ORCHESTRATOR_CONTROL_PORT = 5560
+MOUNT_CONTROL_PORT = 5561
+FOCUSER_CONTROL_PORT = 5562
+CAMERA_CONTROL_PORT = 5563
+
+
+class AbortControlServer:
+    def __init__(self, port: int, handler, name: str):
+        self.port = port
+        self.handler = handler
+        self.name = name
+        self._stop_event = threading.Event()
+        self._ready_event = threading.Event()
+        self._thread = threading.Thread(target=self._serve, name=f"{name}-control", daemon=True)
+        self._error = None
+
+    def start(self):
+        self._thread.start()
+        if not self._ready_event.wait(3.0):
+            raise TimeoutError(f"{self.name} control endpoint did not start on port {self.port}.")
+        if self._error is not None:
+            raise RuntimeError(f"Could not start {self.name} control endpoint: {self._error}")
+
+    def close(self):
+        self._stop_event.set()
+        if self._thread.is_alive():
+            self._thread.join(timeout=2.0)
+
+    def _serve(self):
+        context = zmq.Context.instance()
+        sock = context.socket(zmq.REP)
+        sock.setsockopt(zmq.LINGER, 0)
+        try:
+            sock.bind(f"tcp://*:{self.port}")
+            self._ready_event.set()
+            while not self._stop_event.is_set():
+                if not sock.poll(100, zmq.POLLIN):
+                    continue
+                try:
+                    request = sock.recv_json()
+                    if not isinstance(request, dict):
+                        raise ValueError("Control request must be a JSON object.")
+                    if str(request.get("action", "")).upper() == "PING":
+                        response = {"status": "SUCCESS", "service": self.name}
+                    else:
+                        response = self.handler(request)
+                    sock.send_json(response)
+                except Exception as exc:
+                    logging.exception("Error in %s control endpoint", self.name)
+                    sock.send_json({"status": "ERROR", "message": str(exc)})
+        except Exception as exc:
+            self._error = exc
+            self._ready_event.set()
+        finally:
+            sock.close()
